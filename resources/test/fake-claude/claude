#!/usr/bin/env bash
# Fake claude binary for tests. Emits stream-json events the way
# `claude --print --output-format=stream-json` would. Reads:
#   FAKE_CLAUDE_SESSION_ID  — session id to emit in the init event
#   FAKE_CLAUDE_EXIT_CODE   — exit code to return (default 0)
#   FAKE_CLAUDE_STATUS_FILE — if set, path to write a _run-status.edn
#   FAKE_CLAUDE_DELAY_MS    — sleep before exiting (default 50)
#   FAKE_CLAUDE_HANG_MS     — if set, sleep this long instead of DELAY_MS
#                             (used by budget-timeout tests)
#   FAKE_CLAUDE_NUM_TURNS   — num_turns to emit in the result event (default 3)
#   FAKE_CLAUDE_RESULT_TEXT — result text to emit in the result event (optional)

set -euo pipefail
SESSION_ID="${FAKE_CLAUDE_SESSION_ID:-fake-session-001}"
EXIT_CODE="${FAKE_CLAUDE_EXIT_CODE:-0}"
DELAY_MS="${FAKE_CLAUDE_DELAY_MS:-50}"
HANG_MS="${FAKE_CLAUDE_HANG_MS:-}"
NUM_TURNS="${FAKE_CLAUDE_NUM_TURNS:-3}"
RESULT_TEXT="${FAKE_CLAUDE_RESULT_TEXT:-}"

# init event
printf '{"type":"system","subtype":"init","session_id":"%s"}\n' "$SESSION_ID"
# a fake tool call
printf '{"type":"assistant","tool_use":{"name":"Read"}}\n'
# sleep to let the parent observe at least one event; if HANG_MS is set we
# sleep for that long instead so the parent's budget timer can race us.
if [ -n "$HANG_MS" ]; then
  python3 -c "import time; time.sleep(${HANG_MS}/1000.0)" 2>/dev/null || sleep $(echo "scale=3; $HANG_MS/1000" | bc 2>/dev/null || echo "$((HANG_MS / 1000))")
else
  python3 -c "import time; time.sleep(${DELAY_MS}/1000.0)" 2>/dev/null || sleep 0.05
fi

# optionally write a status file
if [ -n "${FAKE_CLAUDE_STATUS_FILE:-}" ]; then
  mkdir -p "$(dirname "$FAKE_CLAUDE_STATUS_FILE")"
  echo '{:phase :awaiting-input :note "test"}' > "$FAKE_CLAUDE_STATUS_FILE"
fi

# result event
printf '{"type":"result","subtype":"success","num_turns":%s,"is_error":false,"result":"%s"}\n' "$NUM_TURNS" "$RESULT_TEXT"
exit $EXIT_CODE
