{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "overall_correctness",
    "prior_open"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "body",
          "confidence_score",
          "priority",
          "reach",
          "contradicts",
          "code_location"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "confidence_score": {
            "type": "number"
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reach": {
            "type": "string",
            "enum": [
              "local",
              "structural",
              "unclear"
            ]
          },
          "code_location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "absolute_file_path",
              "line_range"
            ],
            "properties": {
              "absolute_file_path": {
                "type": "string"
              },
              "line_range": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "contradicts": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "overall_correctness": {
      "type": "string"
    },
    "prior_open": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "repaired",
              "still_present"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
