  nido:migrate
  {:requires ([tasks.nido-migrate :as nido-migrate])
   :doc "Migrate legacy run/ticket records into the workstream/session model: :project <p>"
   :task (apply nido-migrate/migrate-cmd *command-line-args*)}

  nido:migrate:ledger
  {:requires ([tasks.nido-migrate :as nido-migrate])
   :doc "One-shot: copy each ticket's legacy ledger entries into its workstream (found by ref). :project <p>"
   :task (apply nido-migrate/ledger-cmd *command-line-args*)}

  nido:workstream:entry:add
  {:requires ([tasks.nido-workstream :as nido-workstream])
   :doc "Append an entry to a workstream ledger. :project <p> (:ws-id <id> | :ref <BR-####>) :kind <kw> (:file <path> | :content <str>). A typed kind's body is EDN — pass it as :file."
   :task (apply nido-workstream/entry-add *command-line-args*)}

  nido:workstream:stage:advance
  {:requires ([tasks.nido-workstream :as nido-workstream])
   :doc "Advance a workstream's stage. :project <p> (:ws-id <id> | :ref <BR-####>) :stage <kw>"
   :task (apply nido-workstream/stage-advance *command-line-args*)}

  nido:workstream:close
  {:requires ([tasks.nido-workstream :as nido-workstream])
   :doc "Close a workstream. :project <p> (:ws-id <id> | :ref <BR-####>) :outcome <done|dropped>"
   :task (apply nido-workstream/close-cmd *command-line-args*)}

  nido:workstream:ref:add
  {:requires ([tasks.nido-workstream :as nido-workstream])
   :doc "Add an external ref to a workstream. :project <p> (:ws-id <id> | :ref <BR-####>) :adapter <kw> :id <str> [:url <str> :title <str>]"
   :task (apply nido-workstream/ref-add *command-line-args*)}

  nido:improvement:landed
  {:requires ([tasks.nido-workstream :as nido-workstream])
   :doc "Record that an approved proposal is now in the tree. :project <p> :ws-id <id> :analysis-seq <n> :observation <n> :rev <change-id> [:note <str>]"
   :task (apply nido-workstream/landed-cmd *command-line-args*)}

  nido:improvement:backfill-landings
  {:requires ([tasks.nido-workstream :as nido-workstream])
   :doc "One-shot: discharge every approval whose decision note already records the outcome, from before :improvement-landed existed. Idempotent. :project <p>"
   :task (apply nido-workstream/backfill-landings-cmd *command-line-args*)}

  nido:workstream:show
  {:requires ([tasks.nido-workstream :as nido-workstream])
   :doc "Print a workstream's active ledger (own entries else ticket) + latest entry."
   :task (apply nido-workstream/show-cmd *command-line-args*)}

  nido:review:loop
  {:requires ([tasks.nido-review :as nido-review])
   :doc "Run the codex review loop on the session's branch diff. Runs until it converges/stops progressing unless capped. [:base main] [:max-iters <n>] [:cwd <dir>] [:dry-run? false]"
   :task (System/exit (nido-review/exit-code
                        (apply nido-review/loop-cmd *command-line-args*)))}

  nido:review:baseline
  {:requires ([tasks.nido-review :as nido-review])
   :doc "Loop the baseline round: judge the survey against the code, amend it, repeat until it holds. Uncapped unless :max-iters. :seq names WHICH survey when the workstream holds more than one; the default is the newest. [:cwd <dir>] [:code-cwd <dir>] [:seq <n>] [:max-iters <n>] [:budget 30m] [:dry-run? true]"
   :task (apply nido-review/baseline-cmd *command-line-args*)}

  nido:review:design
  {:requires ([tasks.nido-review :as nido-review])
   :doc "Loop the decision round over the latest design record: derive, amend, re-survey if the premise is wrong, escalate only the ask. [:cwd <dir>] [:code-cwd <dir>] [:max-iters <n>] [:budget 30m] [:dry-run? true]"
   :task (apply nido-review/design-cmd *command-line-args*)}

  nido:work
  {:requires ([tasks.nido-work :as nido-work])
   :doc "Boot an interactive agent in the current worktree with nido context injected. Default :agent claude; supports :agent codex."
   :task (apply nido-work/work *command-line-args*)}

  }}
