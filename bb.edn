   :task (apply nido-ui/start *command-line-args*)}

  nido:tui
  {:requires ([tasks.nido-tui :as nido-tui])
   :doc "Start the nido terminal UI (charm.clj) — projects → sessions CRUD"
   :task (apply nido-tui/run *command-line-args*)}

  nido:nrepl
  {:doc "Dev nREPL for this worktree: bind an ephemeral port, write .nrepl-port, block. Auto-started by nido-managed nido sessions; also runnable manually."
   :task (let [start! (requiring-resolve 'babashka.nrepl.server/start-server!)
               server (start! {:host "127.0.0.1" :port 0})
               port   (.getLocalPort (:socket server))]
           (spit ".nrepl-port" (str port))
           (println (str "nREPL on 127.0.0.1:" port " (.nrepl-port written)"))
           ;; Block on a promise of our own, never on a key of the server map:
           ;; its keys are babashka's internals and change between releases.
           (deref (promise)))}


  nido:run
  {:requires ([tasks.nido-run :as nido-run])
   :doc "Run a project-declared command in a session worktree: :project <p> <session> <command-ref>"
   :task (apply nido-run/run *command-line-args*)}

  nido:land
  {:requires ([tasks.nido-land :as nido-land])
   :doc "Land a revision on nido's main: :rev when given, else the worktree's tip. Fetch, copy its arc onto origin's main in a workspace of the landing's own, bb nido:test and bb nido:land:check there, push main, record the landing on the worktree's workstream, then rebase the daemon's checkout onto main and owe the coordinator a restart it pays itself once no run is live. Without :rev the worktree is brought onto the new main; with it, the worktree is left as it was. Refuses, naming the way out, before pushing anything it cannot show green. [:cwd <dir>] [:rev <revision>]"
   :task (apply nido-land/land-cmd *command-line-args*)}

  nido:land:check
  {:requires ([tasks.nido-land :as nido-land])
   :doc "Refuse a landing whose design does not stand: retracted, never decided, or decided on a survey retracted since. Exits non-zero and prints the way out. [:cwd <dir>] [:ws-cwd <dir> — hold :cwd's files to this worktree's workstream]"
   :task (apply nido-land/cmd *command-line-args*)}

