  nido:session:provision
  {:requires ([tasks.nido-session-provision :as nido-session-provision])
   :doc "The session verb the core calls for a unit's session: :project <p> :want up|stopped|destroyed <session> [:path <worktree>] [:profile <session-profile>]. Works through session-lifecycle alone — no workstream, conductor, seat or agent. Its last line is an EDN result."
   :task (apply nido-session-provision/provision *command-line-args*)}

  nido:session:up
  {:requires ([tasks.nido-session :as nido-session])
   :doc "Bring a session of your own up — no workstream's; a workstream's session is the core's to provision: :project <p> <session> [:wait true] — returns once the worktree and session home exist, services boot in the background (:wait true waits for them); prints session-home path. :ws-id puts the session on that workstream (a fork child, say) instead of minting a one-off; refused before provisioning when it cannot join."
   :task (apply nido-session/up *command-line-args*)}

  nido:session:revive
