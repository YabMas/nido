{:min-bb-version "1.12.215"
 :paths ["src" "resources" "test"]

 :deps {de.timokramer/charm.clj {:mvn/version "0.2.71"}
        metosin/malli           {:mvn/version "0.16.4"}}

 :tasks
 {:requires ([tasks.nido-session :as nido-session]
             [tasks.nido-session-link :as nido-session-link]
             [tasks.nido-project :as nido-project]
             [tasks.nido-template :as nido-template]
             [tasks.nido-reclaim :as nido-reclaim]
             [tasks.nido-vsdd :as nido-vsdd]
             [tasks.nido-ui :as nido-ui]
             [tasks.nido-ci :as nido-ci]
             [tasks.nido-bench :as nido-bench]
             [tasks.nido-harness :as nido-harness]
             [tasks.nido-help :as nido-help]
             [tasks.nido-tui :as nido-tui]
             [tasks.nido-test :as nido-test]
             [tasks.nido-coordinator :as nido-coordinator]
             [tasks.nido-trigger :as nido-trigger]
             [tasks.nido-runs :as nido-runs]
             [tasks.nido-runs-clean :as nido-runs-clean]
             [tasks.nido-notion :as nido-notion]
             [tasks.nido-notion-views :as nido-notion-views]
             [tasks.nido-coordinator-source :as nido-coordinator-source]
             [tasks.nido-transcribe :as nido-transcribe]
             [tasks.nido-notion-preprocess :as nido-notion-preprocess])

  :init (do
          ;; Disable babashka.process/shell's default destroy-tree JVM
          ;; shutdown hook globally for all nido task code. The hook walks
          ;; the spawned child's process tree on JVM exit; on macOS / bb
          ;; 1.12.x it parks indefinitely after the child has already
          ;; terminated, leaving `bb nido:*` stuck forever in shutdown
          ;; (work + output complete, but the bb process never returns —
          ;; pipes don't EOF, outer `timeout` watchdogs hang waiting).
          ;; The two existing `:shutdown nil` annotations on daemon-
          ;; spawning shell calls (`process.clj`, `postgresql.clj`)
          ;; remain explicit so a future reader knows they intentionally
          ;; orphan their child; everything else now defaults safely.
          (require '[babashka.process])
          (alter-var-root
           (var babashka.process/shell)
           (fn [orig]
             (fn shell-no-destroy-tree-default [& xs]
               (let [[opts cmd] (if (map? (first xs))
                                  [(first xs) (rest xs)]
                                  [{} xs])
                     opts'      (if (contains? opts :shutdown)
                                  opts
                                  (assoc opts :shutdown nil))]
                 (apply orig opts' cmd)))))
          (binding [*err* *err*]
            (.println ^java.io.PrintWriter *err*
                      (str "[nido :init] shell altered: "
                           (str babashka.process/shell)))))

  nido:help
  {:doc "Show a grouped overview of nido tasks with examples"
   :task (apply nido-help/show *command-line-args*)}

  nido:init
  {:doc "Create ~/.nido/ skeleton directory structure"
   :task (nido-project/init)}

  nido:project:add
  {:doc "Register a project: <name> <directory>"
   :task (apply nido-project/add *command-line-args*)}

  nido:project:list
  {:doc "List registered projects"
   :task (nido-project/list-cmd)}

  nido:project:remove
  {:doc "Unregister a project: <name>"
   :task (apply nido-project/remove-cmd *command-line-args*)}

  nido:session:up
  {:doc "Bring a session up: :project <p> <session> — services start, prints session-home path"
   :task (apply nido-session/up *command-line-args*)}

  nido:session:down
  {:doc "Stop a session: :project <p> <session> — worktree + state preserved"
   :task (apply nido-session/down *command-line-args*)}

  nido:session:reset
  {:doc "Nuclear recovery: :project <p> <session> — down, drop PGDATA, re-clone template, up"
   :task (apply nido-session/reset *command-line-args*)}

  nido:session:destroy
  {:doc "Destroy a session: :project <p> <session> — down + remove worktree"
   :task (apply nido-session/destroy *command-line-args*)}

  nido:session:enter
  {:doc "Write session-home path to ~/.nido/.last-cd: :project <p> <session> [:cd home|worktree] (pair with the `nido` shell wrapper)"
   :task (apply nido-session/enter *command-line-args*)}

  nido:session:status
  {:doc "Session status: :project <p> <session>"
   :task (apply nido-session/status *command-line-args*)}

  nido:session:list
  {:doc "List sessions: :project <p>"
   :task (apply nido-session/list-sessions *command-line-args*)}

  nido:session:link:add
  {:doc "Add a session link: :type <kw> :url <url> [:title \"...\"]  (project+session auto-resolved from session-home cwd)"
   :task (apply nido-session-link/add *command-line-args*)}

  nido:session:link:remove
  {:doc "Remove a session link by url: :url <url>  (project+session auto-resolved from session-home cwd)"
   :task (apply nido-session-link/remove-cmd *command-line-args*)}

  nido:session:link:list
  {:doc "List session links grouped by type  (project+session auto-resolved from session-home cwd)"
   :task (apply nido-session-link/list-cmd *command-line-args*)}

  nido:template:pg:init
  {:doc "Initialize a per-project Postgres template cluster (empty schema)"
   :task (apply nido-template/init *command-line-args*)}

  nido:template:pg:refresh
  {:doc "Refresh the template from a fresh dump via project-declared :refresh-steps"
   :task (apply nido-template/refresh *command-line-args*)}

  nido:template:pg:status
  {:doc "Show template cluster status for a project"
   :task (apply nido-template/status *command-line-args*)}

  nido:template:pg:stop
  {:doc "Stop the template cluster (no-op if already stopped)"
   :task (apply nido-template/stop *command-line-args*)}

  nido:template:pg:destroy
  {:doc "Delete the template cluster for a project"
   :task (apply nido-template/destroy *command-line-args*)}

  nido:reclaim
  {:doc "List (or with :force? true, delete) per-instance state dirs not tracked in the registry"
   :task (apply nido-reclaim/run *command-line-args*)}

  nido:harness:sync
  {:doc "Reconcile nido/.claude/ symlinks against .claude/harness.edn (add new, prune deleted, respect overrides)"
   :task (apply nido-harness/sync-cmd *command-line-args*)}

  nido:bench:memory
  {:doc "Run the memory-bench lever matrix for a project: :project <name> [:levers [kw...]] [:session <name>]"
   :task (apply nido-bench/memory *command-line-args*)}

  nido:bench:memory:levers
  {:doc "List known bench levers"
   :task (apply nido-bench/levers *command-line-args*)}

  nido:ui
  {:doc "Start the nido dashboard [:port 8800]"
   :task (apply nido-ui/start *command-line-args*)}

  nido:tui
  {:doc "Start the nido terminal UI (charm.clj) — projects → sessions CRUD"
   :task (apply nido-tui/run *command-line-args*)}

  nido:vsdd:run
  {:doc "Run VSDD loop: :project-dir <path> :module-path <path>"
   :task (apply nido-vsdd/run *command-line-args*)}

  nido:vsdd:resume
  {:doc "Resume an interrupted VSDD run: :project-dir <path> :run-id <id>"
   :task (apply nido-vsdd/resume *command-line-args*)}

  nido:vsdd:analyze
  {:doc "Analyze a VSDD run: :project-dir <path> :run-id <id> [:model opus]"
   :task (apply nido-vsdd/analyze *command-line-args*)}

  nido:vsdd:sweep
  {:doc "Run VSDD across all changed modules: :project-dir <path>"
   :task (apply nido-vsdd/sweep *command-line-args*)}

  nido:ci:run
  {:doc "Run ci.edn: :project <p> <session> [:only <step-or-vec>] (all steps by default, parallel)"
   :task (apply nido-ci/run *command-line-args*)}

  nido:ci:rerun
  {:doc "Re-run failed steps from last Run: :project <p> <session> [:from <run-id>]"
   :task (apply nido-ci/rerun *command-line-args*)}

  nido:test
  {:doc "Run unit tests. Optional :only <ns-prefix> to filter."
   :task (apply nido-test/run *command-line-args*)}

  nido:coordinator:run
  {:doc "Run coordinator in foreground (stage 1a). Optional :poll-ms <int>."
   :task (apply nido-coordinator/run *command-line-args*)}

  nido:coordinator:status
  {:doc "Show coordinator heartbeat + state from status.edn"
   :task (apply nido-coordinator/status *command-line-args*)}

  nido:coordinator:halt
  {:doc "Pause the coordinator: write halted.edn so no new Runs spawn. Optional :note <str>."
   :task (apply nido-coordinator/halt *command-line-args*)}

  nido:coordinator:resume
  {:doc "Resume after halt: remove halted.edn so the daemon ticks again."
   :task (apply nido-coordinator/resume *command-line-args*)}

  nido:coordinator:up
  {:doc "Spawn coordinator daemon in background. Optional :poll-ms <int>. Logs to coordinator.log."
   :task (apply nido-coordinator/up *command-line-args*)}

  nido:coordinator:down
  {:doc "Stop the background daemon. SIGTERM by default. :force true → SIGKILL."
   :task (apply nido-coordinator/down *command-line-args*)}

  nido:coordinator:logs
  {:doc "Tail the coordinator log. Default last 50 lines. :follow true to follow."
   :task (apply nido-coordinator/logs *command-line-args*)}

  nido:coordinator:install
  {:doc "Write the LaunchAgent plist and start the daemon. Auto-starts at login."
   :task (apply nido-coordinator/install *command-line-args*)}

  nido:coordinator:uninstall
  {:doc "Bootout and remove the LaunchAgent plist. Idempotent."
   :task (apply nido-coordinator/uninstall *command-line-args*)}

  nido:coordinator:restart
  {:doc "Restart the daemon via launchctl kickstart -k (requires install)."
   :task (apply nido-coordinator/restart *command-line-args*)}

  nido:notion:auth:set
  {:doc "Store a Notion integration token in the macOS Keychain (interactive)."
   :task (apply nido-notion/auth-set *command-line-args*)}

  nido:notion:auth:check
  {:doc "Print whether a Notion token is present in the macOS Keychain."
   :task (apply nido-notion/auth-check *command-line-args*)}

  nido:notion:views:check
  {:doc "Validate ~/.nido/projects/<p>/notion-views.edn against the live database. :project <p>."
   :task (apply nido-notion-views/check-cmd *command-line-args*)}

  nido:notion:preprocess-ticket
  {:doc "Preprocess a Notion ticket (transcribe videos): :page <id> :out <dir> [:budget 10m]"
   :task (apply nido-notion-preprocess/run *command-line-args*)}

  nido:coordinator:source:list
  {:doc "List source-instance state files."
   :task (apply nido-coordinator-source/list-cmd *command-line-args*)}

  nido:coordinator:source:reset
  {:doc "Clear breaker + failure counter for a source-instance."
   :task (apply nido-coordinator-source/reset-cmd *command-line-args*)}

  nido:transcribe-video
  {:doc "Transcribe a video URL → VTT: <url> :out <path> [:model :small] [:timeout 5m]"
   :task (apply nido-transcribe/run *command-line-args*)}

  nido:halt
  {:doc "Alias for nido:coordinator:halt — the panic button."
   :task (apply nido-coordinator/halt *command-line-args*)}

  nido:trigger:fire
  {:doc "Fire a manual trigger: :project <p> <trigger> :<payload-key> <value> ..."
   :task (apply nido-trigger/fire *command-line-args*)}

  nido:trigger:list
  {:doc "List configured triggers: :project <p>"
   :task (apply nido-trigger/list-triggers *command-line-args*)}

  nido:trigger:enable
  {:doc "Clear circuit-breaker / re-enable a trigger: :project <p> <trigger>"
   :task (apply nido-trigger/enable *command-line-args*)}

  nido:trigger:disable
  {:doc "Manually disable a trigger: :project <p> <trigger> [:note <str>]"
   :task (apply nido-trigger/disable *command-line-args*)}

  nido:runs:clean
  {:doc "Clean terminal-state Runs (run dir + session-home + state dir). Dry-run by default. :state, :older-than, :project, :dry-run? options."
   :task (apply nido-runs-clean/clean-cmd *command-line-args*)}

  nido:runs:list
  {:doc "List runs. Filters: :state <kw> :trigger <kw> :project <kw>"
   :task (apply nido-runs/list-runs *command-line-args*)}

  nido:runs:show
  {:doc "Show full run.edn + last 50 lines of agent.log: <run-id>"
   :task (apply nido-runs/show *command-line-args*)}

  }}
