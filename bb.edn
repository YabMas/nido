   :task (apply nido-drain/misfit-cmd *command-line-args*)}

  nido:drain:census
  {:requires ([tasks.nido-drain :as nido-drain])
   :doc "Take a drain's census now: run its current recipe's counter against the project's main checkout and append the reading when it moved. Exits 1 on a failed reading. [:cwd <dir>] or :project <p> :drain <ws-id>"
   :task (apply nido-drain/census-cmd *command-line-args*)}

  nido:activate
  {:requires ([tasks.nido-activate :as nido-activate])
   :doc "Hand a workstream to the core: its unit opened, in a session the core provisions — never the one this runs in. [:cwd <dir>] or :project <p> :ws <ws-id>"
   :task (apply nido-activate/activate-cmd *command-line-args*)}

  nido:deactivate
  {:requires ([tasks.nido-deactivate :as nido-deactivate])
   :doc "Take nido's recipe off this session's workstream: append its :deactivated entry. Its conductor stops, nothing is owed, and its designs no longer gate its landing; `nido:activate` turns it back on. [:cwd <dir>] or :project <p> :ws <ws-id>"
   :task (apply nido-deactivate/deactivate-cmd *command-line-args*)}

  nido:attach
  {:requires ([tasks.nido-attach :as nido-attach])
   :doc "Attach to this worktree's workstream: follow whatever is running, else say what is owed and who runs it. Takes no stage. [:cwd <dir>]"
   :task (apply nido-attach/attach-cmd *command-line-args*)}

  nido:work
  {:requires ([tasks.nido-work :as nido-work])
   :doc "Boot an interactive agent in the current worktree with nido context injected. Default :agent claude; supports :agent codex. [:name <agent name>] [:prompt-file <path> — its contents are the first turn] [:permission-mode <m>] [:model <id>] (claude only)"
   :task (apply nido-work/work *command-line-args*)}

  }}
